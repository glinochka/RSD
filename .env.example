# =============================================================================
# RSD /custom (custom agents / mass social automation) environment variables
# Copy this block into the root `.env` file and fill in real values.
# Runbook: docs/custom/RUNBOOK.md
# =============================================================================

# --- /custom admin credentials ---
CUSTOM_ADMIN_LOGIN=custom_admin
# Use $$ for each literal $ so Docker Compose does not treat e.g. $qq as a variable.
CUSTOM_ADMIN_PASSWORD_HASH=
CUSTOM_ADMIN_JWT_SECRET_KEY=change-me-32-char-min-secret
CUSTOM_AUTOMATION_JWT_SECRET_KEY=change-me-32-char-min-secret

# --- Telegram userbot credentials (my.telegram.org or use opentele fallback) ---
TELEGRAM_USERBOT_API_ID=0
TELEGRAM_USERBOT_API_HASH=

# --- DMP.one integration (optional) ---
DMP_ONE_API_BASE_URL=https://api.dmp.one/v1
DMP_ONE_API_KEY=
DMP_ONE_WEBHOOK_SECRET=
DMP_ONE_POLL_INTERVAL_SECONDS=300
DMP_ONE_OUTREACH_ENABLED=true

# --- AmoCRM integration (optional) ---
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://example.com/amocrm/callback

# --- Lead delivery notifications (optional) ---
# lead_manager_contact in automation settings accepts Telegram username/id,
# email or webhook URL. Email/webhook use the platform mailer below.
MAILOPOST_API_TOKEN=
MAILOPOST_FROM_EMAIL=noreply@example.com
MAILOPOST_FROM_NAME=RSD Custom Agents

# --- /custom scheduler intervals ---
CUSTOM_SCHEDULER_REFRESH_INTERVAL_SECONDS=60
CUSTOM_MONITOR_INTERVAL_SECONDS=60
    CUSTOM_JOIN_INTERVAL_SECONDS=120
CUSTOM_DISCOVERY_INTERVAL_SECONDS=30
CUSTOM_NEUROCOMMENTING_INTERVAL_SECONDS=300
CUSTOM_DISCUSSION_INTERVAL_SECONDS=240
CUSTOM_LEAD_WARMUP_INTERVAL_SECONDS=90
CUSTOM_AMOCRM_SYNC_INTERVAL_SECONDS=600
