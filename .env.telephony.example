# =============================================================================
# RSD Telephony — streaming PSTN
# Скопируйте нужные блоки в корневой `.env`
# Справка: docs/telephony/ENV_VARIABLES.md
# Настройка Voximplant / Yandex: docs/telephony/EXTERNAL_SERVICES.md
# =============================================================================
#
# Prod-путь звонка:
#   VoxEngine (rsd_inbound.js) → WSS telephony_media_gateway → Redis → orchestrator
#   telephony_bridge — call.inbound / call.answered / call.hangup
#
# Docker: docker compose up -d redis backend telephony_worker telephony_bridge
#         telephony_orchestrator telephony_media_gateway
# =============================================================================

# --- Shared secrets (генерация: openssl rand -hex 32) ---
INTERNAL_API_KEY=change-me-internal-api-key-32chars-min
INTERNAL_REQUEST_SIGNING_SECRET=change-me-signing-secret-64chars-recommended-hex
TELEPHONY_INTERNAL_API_KEY=
TELEPHONY_BRIDGE_API_KEY=change-me-bridge-api-key-hex
ENCRYPTION_KEY=change-me-fernet-or-app-encryption-key

# --- Platform pool: один номер Voximplant для всех агентов ---
# Агент в UI задаёт только 4-значный добавочный (DTMF после звонка или набор номер,добавочный)
TELEPHONY_SHARED_POOL_E164=+74990000000
TELEPHONY_VOXIMPLANT_ACCOUNT_ID=1234567
TELEPHONY_VOXIMPLANT_API_KEY=your-voximplant-api-key-min-8-chars
TELEPHONY_VOXIMPLANT_APPLICATION_ID=12345678
TELEPHONY_VOXIMPLANT_RULE_ID=987654
TELEPHONY_OPERATOR_TRANSFER_E164=+74990000001

# --- Backend (FastAPI) + telephony_worker + telephony_orchestrator ---
TELEPHONY_ENABLED=false
TELEPHONY_ORCHESTRATOR_ENABLED=true
TELEPHONY_STREAMING_ENABLED=true
TELEPHONY_WEBHOOK_BASE_URL=https://telephony.example.com
TELEPHONY_MAX_TURN_SECONDS=30
TELEPHONY_MAX_CALL_MINUTES=15
TELEPHONY_MAX_TURNS=15
TELEPHONY_TURNS_RETENTION_DAYS=90
TELEPHONY_WEBHOOK_SIGNATURE_TTL_SECONDS=300
TELEPHONY_WEBHOOK_RATE_LIMIT_PER_CONNECTION=120
TELEPHONY_WEBHOOK_RATE_LIMIT_PER_IP=240
TELEPHONY_WEBHOOK_RATE_WINDOW_SECONDS=60
TELEPHONY_LLM_MODE=chat
TELEPHONY_GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TELEPHONY_LLM_TIMEOUT_SECONDS=8
TELEPHONY_LLM_RETRY_TIMEOUT_SECONDS=5
TELEPHONY_PREVIEW_LLM_TIMEOUT_SECONDS=8
TELEPHONY_SYNTAGMA_MIN_CHARS=12
TELEPHONY_CRM_FILLER_THRESHOLD_MS=1500
TELEPHONY_SSML_ENABLED=true
TELEPHONY_STREAM_TTS_PROVIDER=yandex
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=
ELEVENLABS_API_KEY=
TELEPHONY_TTS_PROVIDER=yandex
TELEPHONY_TTS_TIMEOUT_SECONDS=10
OPENAI_API_KEY=
VOICE_STT_BACKEND=auto
REDIS_URL=redis://redis:6379/0
TELEPHONY_REDIS_SESSION_TTL_SEC=7200
TELEPHONY_DIALOG_MAX_TURNS=16
TELEPHONY_DEDICATED_POOL_ENABLED=true
TELEPHONY_DEDICATED_POOL_SIZE=8
TELEPHONY_WORKER_PORT=8001
TELEPHONY_TURN_LATENCY_ALERT_P95_MS=3000
TELEPHONY_E2R_ALERT_P90_MS=3000
VOXIMPLANT_API_BASE_URL=https://api.voximplant.com/platform_api
TELEPHONY_VOXIMPLANT_API_TIMEOUT_SECONDS=15

# --- telephony_bridge (control-only) ---
TELEPHONY_BACKEND_URL=http://telephony_worker:8001
TELEPHONY_BACKEND_INTERNAL_KEY=
TELEPHONY_BACKEND_SIGNING_SECRET=
TELEPHONY_SESSION_STORE=redis
TELEPHONY_BACKEND_REQUEST_TIMEOUT_MS=15000
TELEPHONY_BRIDGE_CONTROL_ONLY=true
PORT=8100

# --- telephony_media_gateway ---
PORT=8200
NODE_ENV=development
TELEPHONY_MEDIA_WS_PATH=/ws
TELEPHONY_MEDIA_AUDIO_FRAME_MS=20
TELEPHONY_MEDIA_LOG_LEVEL=info
TELEPHONY_MEDIA_MAX_CONTROL_BYTES=65536
TELEPHONY_MEDIA_LOOPBACK_TRANSPORT=vox
TELEPHONY_MEDIA_LOOPBACK_MODE=echo
TELEPHONY_MEDIA_PIPELINE_ENABLED=true
STT_PROVIDER=yandex
TELEPHONY_STT_LANGUAGE=ru-RU
TURN_SILENCE_MS=400
STT_FINAL_WAIT_MS=80
STT_PARTIAL_LOG_EVERY=5
DEEPGRAM_API_KEY=
VAD_MODEL_PATH=./telephony_media_gateway/models/silero_vad.onnx
VAD_SPEECH_THRESHOLD=0.5
VAD_ENERGY_THRESHOLD=0.02
TELEPHONY_ORCH_EVENTS_ENABLED=true
TELEPHONY_ORCH_EVENTS_CHANNEL=telephony:orch:events
TELEPHONY_ORCH_REPLIES_CHANNEL=telephony:orch:replies
TELEPHONY_BARGE_IN_ENABLED=true
TELEPHONY_BARGE_IN_SPEECH_FRAMES=2
TELEPHONY_MEDIA_WS_URL=wss://telephony.example.com/ws

# --- VoxEngine secrets (кабинет Voximplant, не .env сервера) ---
# RSD_WEBHOOK_SECRET=<webhook_secret канала после подключения агента>
# RSD_WEBHOOK_BASE_URL=https://telephony.example.com
# script_custom_data: require_extension true для общего номера

