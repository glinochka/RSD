# Telephony — copy relevant lines into project root .env
# See docs/telephony/ENV_VARIABLES.md

# --- Shared secrets (generate: openssl rand -hex 32) ---
INTERNAL_API_KEY=
INTERNAL_REQUEST_SIGNING_SECRET=
TELEPHONY_INTERNAL_API_KEY=
TELEPHONY_BRIDGE_API_KEY=

# --- Backend (FastAPI + telephony_worker) ---
TELEPHONY_ENABLED=false
TELEPHONY_WEBHOOK_BASE_URL=https://telephony.example.com
TELEPHONY_MAX_TURN_SECONDS=30
TELEPHONY_MAX_CALL_MINUTES=15
TELEPHONY_MAX_TURNS=15
TELEPHONY_TTS_PROVIDER=voximplant
YANDEX_SPEECHKIT_API_KEY=
TELEPHONY_WEBHOOK_SIGNATURE_TTL_SECONDS=300
TELEPHONY_WEBHOOK_RATE_LIMIT_PER_CONNECTION=120
TELEPHONY_WEBHOOK_RATE_LIMIT_PER_IP=240
TELEPHONY_WEBHOOK_RATE_WINDOW_SECONDS=60
TELEPHONY_TURNS_RETENTION_DAYS=90
TELEPHONY_LLM_TIMEOUT_SECONDS=8
TELEPHONY_LLM_RETRY_TIMEOUT_SECONDS=3
TELEPHONY_TURN_LATENCY_ALERT_P95_MS=10000
TELEPHONY_STREAMING_ENABLED=true
TELEPHONY_ENDPOINT_SILENCE_MS=600
TELEPHONY_CRM_FILLER_THRESHOLD_MS=1500
TELEPHONY_DEDICATED_POOL_ENABLED=true
TELEPHONY_DEDICATED_POOL_SIZE=8
TELEPHONY_WORKER_PORT=8001
TELEPHONY_BARGE_IN_ENABLED=true
TELEPHONY_BACKCHANNEL_MIN_MS=5000
TELEPHONY_SSML_ENABLED=true
REDIS_URL=redis://redis:6379/0
VOXIMPLANT_API_BASE_URL=https://api.voximplant.com/platform_api
TELEPHONY_VOXIMPLANT_API_TIMEOUT_SECONDS=15
# STT for /internal/telephony/turn (if no local faster-whisper)
VOICE_STT_BACKEND=auto
OPENAI_API_KEY=

# --- telephony_bridge ---
TELEPHONY_BACKEND_URL=http://telephony_worker:8001
TELEPHONY_BACKEND_INTERNAL_KEY=
TELEPHONY_BACKEND_SIGNING_SECRET=
TELEPHONY_SESSION_STORE=redis
TELEPHONY_RECORD_SILENCE_SEC=0
TELEPHONY_BACKEND_REQUEST_TIMEOUT_MS=15000
PORT=8100

# --- Voximplant test account (do not commit real values) ---
# Stored per-channel in encrypted_credentials after UI connect.
# VOXIMPLANT_ACCOUNT_ID=
# VOXIMPLANT_API_KEY=
# VOXIMPLANT_APPLICATION_ID=
# VOXIMPLANT_RULE_ID=
# VOXIMPLANT_PHONE_E164=+79XXXXXXXXX
