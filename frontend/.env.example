# API Configuration (backend address; backend runs on port 8000)
# Ensure frontend origin (e.g. http://localhost:3000) is in backend CORS: backend/app/origins.py
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_ANALYTICS=true
