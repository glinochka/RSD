# Public site URL (canonical origin for SEO: og:url, sitemap alignment). Example: https://rsd-ai.ru
# In local dev, if unset, the app uses window.location.origin for meta tags.
VITE_PUBLIC_SITE_URL=https://rsd-ai.ru

# API base for Axios. Paths in src/config/constants.js already start with /api/...
# - Local dev (npm run vite): omit this or use http://localhost:8000
# - Docker + nginx same-origin: leave empty (VITE_API_BASE_URL=) — do NOT use /api (double prefix)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_VERSION=1.0.0
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Feature Flags
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_ANALYTICS=true

# Embedded chat widget (optional). If VITE_WIDGET_API_KEY is empty, widget is not injected.
VITE_WIDGET_API_BASE=https://rsd-ai.ru
VITE_WIDGET_API_KEY=
VITE_WIDGET_POSITION=bottom-right
VITE_WIDGET_TITLE=Онлайн-консультант RSD AI
VITE_WIDGET_GREETING=Здравствуйте! Чем могу помочь?
VITE_WIDGET_PLACEHOLDER=Напишите ваш вопрос...
# Theme: dark (default), light, ocean, forest, sunset, darkmode
VITE_WIDGET_THEME=dark

# Proactive outgoing messages — shown as a speech bubble above the chat button (optional).
# If message is set but delay is not, defaults are used (3s for first, 1s for second).
# Delay in seconds (e.g. 5 = 5 seconds on page before bubble appears).
VITE_WIDGET_PROACTIVE_MESSAGE=Здравствуйте! Чем могу помочь?
VITE_WIDGET_PROACTIVE_DELAY=3
VITE_WIDGET_PROACTIVE_MESSAGE_2=Добавим такой же чат на ваш сайт?
VITE_WIDGET_PROACTIVE_DELAY_2=1
