# Stage 1: Build the Vite app (env vars baked in at build time)
FROM node:20-alpine AS builder

WORKDIR /app

# Build-time API URL (browser). Empty = same-origin (paths in app already start with /api).
ARG VITE_API_BASE_URL=
ARG VITE_API_TIMEOUT=30000
ARG VITE_GOOGLE_CLIENT_ID=
ARG VITE_WIDGET_API_BASE=
ARG VITE_WIDGET_API_KEY=
ARG VITE_WIDGET_POSITION=bottom-right
ARG VITE_WIDGET_TITLE=
ARG VITE_WIDGET_GREETING=
ARG VITE_WIDGET_PLACEHOLDER=
ARG VITE_WIDGET_THEME=dark
ARG VITE_WIDGET_PROACTIVE_MESSAGE=
ARG VITE_WIDGET_PROACTIVE_DELAY=
ARG VITE_WIDGET_PROACTIVE_MESSAGE_2=
ARG VITE_WIDGET_PROACTIVE_DELAY_2=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_API_TIMEOUT=${VITE_API_TIMEOUT}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
ENV VITE_WIDGET_API_BASE=${VITE_WIDGET_API_BASE}
ENV VITE_WIDGET_API_KEY=${VITE_WIDGET_API_KEY}
ENV VITE_WIDGET_POSITION=${VITE_WIDGET_POSITION}
ENV VITE_WIDGET_TITLE=${VITE_WIDGET_TITLE}
ENV VITE_WIDGET_GREETING=${VITE_WIDGET_GREETING}
ENV VITE_WIDGET_PLACEHOLDER=${VITE_WIDGET_PLACEHOLDER}
ENV VITE_WIDGET_THEME=${VITE_WIDGET_THEME}
ENV VITE_WIDGET_PROACTIVE_MESSAGE=${VITE_WIDGET_PROACTIVE_MESSAGE}
ENV VITE_WIDGET_PROACTIVE_DELAY=${VITE_WIDGET_PROACTIVE_DELAY}
ENV VITE_WIDGET_PROACTIVE_MESSAGE_2=${VITE_WIDGET_PROACTIVE_MESSAGE_2}
ENV VITE_WIDGET_PROACTIVE_DELAY_2=${VITE_WIDGET_PROACTIVE_DELAY_2}

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Serve with Nginx (production)
FROM nginx:alpine

# Production image: static SPA only (TLS/routing in deploy/nginx on edge proxy).
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.static.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
