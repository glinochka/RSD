{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsd.local/schemas/telephony/credentials.v1.schema.json",
  "title": "RSD Telephony Channel Credentials v1",
  "description": "Plaintext JSON stored in agent_channel_connections.encrypted_credentials (after encrypt_token). Provider MVP: Voximplant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "account_id",
    "api_key",
    "application_id",
    "rule_id",
    "phone_number_e164",
    "webhook_secret",
    "operator_transfer_e164",
    "voice_id",
    "language",
    "record_calls",
    "disclaimer_played"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "const": "voximplant",
      "description": "CPaaS variant inside encrypted JSON; DB provider is telephony_voximplant"
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "description": "Voximplant account ID"
    },
    "api_key": {
      "type": "string",
      "minLength": 8,
      "description": "Voximplant API key"
    },
    "application_id": {
      "type": "string",
      "minLength": 1,
      "description": "Voximplant application ID"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "description": "Inbound routing rule ID"
    },
    "phone_number_e164": {
      "type": "string",
      "pattern": "^\\+[1-9]\\d{6,14}$",
      "description": "Inbound DID in E.164"
    },
    "webhook_secret": {
      "type": "string",
      "minLength": 32,
      "description": "HMAC secret for RFC-001 webhook signatures"
    },
    "operator_transfer_e164": {
      "type": "string",
      "pattern": "^\\+[1-9]\\d{6,14}$",
      "description": "Human operator number for escalation"
    },
    "voice_id": {
      "type": "string",
      "minLength": 1,
      "description": "TTS voice identifier (provider-specific)"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "default": "ru-RU",
      "description": "BCP 47 language tag for TTS/STT/disclaimer"
    },
    "record_calls": {
      "type": "boolean",
      "description": "Enable call recording at CPaaS"
    },
    "disclaimer_played": {
      "type": "boolean",
      "description": "If true, bridge must play legal IVR before agent dialogue"
    },
    "routing_extension": {
      "type": "string",
      "pattern": "^\\d{4}$",
      "description": "4-digit DTMF extension for shared pool inbound (variant A)"
    },
    "inbound_numbers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\+[1-9]\\d{6,14}$"
      },
      "description": "Additional dedicated DIDs (variant B)"
    }
  }
}
